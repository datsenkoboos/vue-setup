{
  "name": "vue-setup",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sb": "storybook dev -p 6006 --no-open",
    "build": "run-p typecheck \"vite build {@}\" --",
    "build:sb": "storybook build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "typecheck": "vue-tsc --build",
    "fmt": "oxfmt",
    "lint": "oxlint && eslint --max-warnings 0",
    "lint:fix": "oxlint --fix && eslint --fix",
    "check": "run-p typecheck lint \"fmt --check\"",
    "gen:base": "hygen base new"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.6.0",
    "@storybook/vue3-vite": "^10.5.6",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.3",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-fans": "^1.11.0",
    "eslint-plugin-de-morgan": "^2.1.3",
    "eslint-plugin-oxlint": "^1.76.0",
    "eslint-plugin-storybook": "^10.5.6",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "hygen": "^6.2.11",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "npm-run-all2": "^9.0.2",
    "oxc-config-fans": "^1.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "storybook": "^10.5.6",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
